{
  "name": "scs",
  "nodes": {
    "task_input": {
      "id": "task_input",
      "reads": [],
      "writes": [
        "budget_state.json",
        "eval.py",
        "initial.py",
        "knobs.json",
        "task.yaml"
      ],
      "blocking": true,
      "command": "python -m srf.ops.common.task_input",
      "callable_name": null,
      "notes": "Materialize the selected task into the work directory.",
      "_type": "FnNode"
    },
    "seed_run": {
      "id": "seed_run",
      "reads": [],
      "writes": [
        "best_solution.py",
        "population.json",
        "scs_state.json"
      ],
      "blocking": true,
      "command": "python -m srf.ops.common.seed best_solution.py population.json scs_state.json",
      "callable_name": null,
      "notes": "Seed the run's population, tree, and per-mode state files.",
      "_type": "FnNode"
    },
    "budget_check": {
      "id": "budget_check",
      "reads": [
        "budget_state.json"
      ],
      "writes": [],
      "blocking": true,
      "evaluator_type": "fn",
      "evaluator_role": null,
      "evaluator_command": "python -m srf.ops.common.budget check",
      "gate_prompt": "reloop while the eval budget is unspent, proceed once it is spent.",
      "max_iterations": 500,
      "_type": "GateNode"
    },
    "exit_scs": {
      "id": "exit_scs",
      "reads": [],
      "writes": [],
      "blocking": true,
      "command": "true",
      "callable_name": null,
      "notes": "Loop exit point",
      "_type": "FnNode"
    },
    "sample": {
      "id": "sample",
      "reads": [
        "population.json"
      ],
      "writes": [
        "selected_parent.json"
      ],
      "blocking": true,
      "command": "python -m srf.ops.run srf.ops.scs.ops:sample_from_archive",
      "callable_name": "srf.ops.scs.ops:sample_from_archive",
      "notes": "",
      "_type": "FnNode"
    },
    "build_prompt": {
      "id": "build_prompt",
      "reads": [
        "population.json",
        "selected_parent.json",
        "task.yaml"
      ],
      "writes": [
        "scs_prompt.md"
      ],
      "blocking": true,
      "command": "python -m srf.ops.run srf.ops.scs.ops:build_scs_prompt",
      "callable_name": "srf.ops.scs.ops:build_scs_prompt",
      "notes": "",
      "_type": "FnNode"
    },
    "generate_code": {
      "id": "generate_code",
      "reads": [
        "scs_prompt.md"
      ],
      "writes": [
        "candidate.py"
      ],
      "blocking": true,
      "system_prompt": "You are SCS, a stochastic code search agent. Given archive context showing the best solutions found so far, produce an improved version. Output a single fenced code block.",
      "instance_prompt": "",
      "model": "",
      "provider": "auto",
      "max_tokens": 8192,
      "max_turns": 10,
      "temperature": 0.7,
      "stop_sequences": [],
      "tools": [],
      "tool_choice": "auto",
      "timeout": 600,
      "_type": "LLMNode"
    },
    "sandbox_eval": {
      "id": "sandbox_eval",
      "reads": [
        "candidate.py",
        "task.yaml"
      ],
      "writes": [
        "eval_result.json"
      ],
      "blocking": true,
      "command": "python -m srf.ops.run srf.ops.common.sandbox:run_eval",
      "callable_name": "srf.ops.common.sandbox:run_eval",
      "notes": "Run the task's eval command on the candidate and record the score.",
      "_type": "FnNode"
    },
    "archive_update": {
      "id": "archive_update",
      "reads": [
        "candidate.py",
        "eval_result.json",
        "population.json",
        "selected_parent.json"
      ],
      "writes": [
        "best_solution.py",
        "population.json",
        "scs_state.json"
      ],
      "blocking": true,
      "command": "python -m srf.ops.run srf.ops.scs.ops:update_archive",
      "callable_name": "srf.ops.scs.ops:update_archive",
      "notes": "",
      "_type": "FnNode"
    }
  },
  "edges": [
    {
      "source": "build_prompt",
      "target": "generate_code",
      "condition": null
    },
    {
      "source": "sample",
      "target": "build_prompt",
      "condition": null
    },
    {
      "source": "generate_code",
      "target": "sandbox_eval",
      "condition": null
    },
    {
      "source": "sandbox_eval",
      "target": "archive_update",
      "condition": null
    },
    {
      "source": "archive_update",
      "target": "budget_check",
      "condition": null
    },
    {
      "source": "budget_check",
      "target": "sample",
      "condition": "reloop"
    },
    {
      "source": "budget_check",
      "target": "exit_scs",
      "condition": "proceed"
    },
    {
      "source": "task_input",
      "target": "seed_run",
      "condition": null
    },
    {
      "source": "seed_run",
      "target": "sample",
      "condition": null
    }
  ],
  "start_node": "task_input",
  "terminal": true,
  "knob_values": {
    "temperature": 0.7,
    "parent_selection": "best"
  },
  "knob_bounds": {
    "temperature": [
      0.3,
      0.5,
      0.7,
      0.9,
      1.0
    ],
    "parent_selection": [
      "best",
      "epsilon_greedy",
      "power_law",
      "uniform"
    ]
  }
}
