{
  "name": "shinka",
  "nodes": {
    "task_input": {
      "id": "task_input",
      "reads": [],
      "writes": [
        "budget_state.json",
        "eval.py",
        "initial.py",
        "knobs.json",
        "task.yaml"
      ],
      "blocking": true,
      "command": "python -m srf.ops.common.task_input",
      "callable_name": null,
      "notes": "Materialize the selected task into the work directory.",
      "_type": "FnNode"
    },
    "seed_run": {
      "id": "seed_run",
      "reads": [],
      "writes": [
        "best_solution.py",
        "population.json",
        "shinka_state.json"
      ],
      "blocking": true,
      "command": "python -m srf.ops.common.seed best_solution.py population.json shinka_state.json",
      "callable_name": null,
      "notes": "Seed the run's population, tree, and per-mode state files.",
      "_type": "FnNode"
    },
    "budget_check": {
      "id": "budget_check",
      "reads": [
        "budget_state.json"
      ],
      "writes": [],
      "blocking": true,
      "evaluator_type": "fn",
      "evaluator_role": null,
      "evaluator_command": "python -m srf.ops.common.budget check",
      "gate_prompt": "reloop while the eval budget is unspent, proceed once it is spent.",
      "max_iterations": 500,
      "_type": "GateNode"
    },
    "exit_shinka": {
      "id": "exit_shinka",
      "reads": [],
      "writes": [],
      "blocking": true,
      "command": "true",
      "callable_name": null,
      "notes": "Loop exit point",
      "_type": "FnNode"
    },
    "sample_reflect": {
      "id": "sample_reflect",
      "reads": [
        "population.json",
        "shinka_state.json"
      ],
      "writes": [
        "reflection.md",
        "selected_parent.json"
      ],
      "blocking": true,
      "command": "python -m srf.ops.run srf.ops.shinka.ops:sample_and_reflect",
      "callable_name": "srf.ops.shinka.ops:sample_and_reflect",
      "notes": "",
      "_type": "FnNode"
    },
    "build_prompt": {
      "id": "build_prompt",
      "reads": [
        "reflection.md",
        "selected_parent.json",
        "task.yaml"
      ],
      "writes": [
        "shinka_prompt.md"
      ],
      "blocking": true,
      "command": "python -m srf.ops.run srf.ops.shinka.ops:build_shinka_prompt",
      "callable_name": "srf.ops.shinka.ops:build_shinka_prompt",
      "notes": "",
      "_type": "FnNode"
    },
    "generate": {
      "id": "generate",
      "reads": [
        "shinka_prompt.md"
      ],
      "writes": [
        "candidate.py"
      ],
      "blocking": true,
      "system_prompt": "You are ShinkaEvolve, an evolutionary optimizer with reflection capabilities. Evolve the solution using insights from past attempts. Output a single fenced code block.",
      "instance_prompt": "",
      "model": "",
      "provider": "auto",
      "max_tokens": 8192,
      "max_turns": 10,
      "temperature": 0.7,
      "stop_sequences": [],
      "tools": [],
      "tool_choice": "auto",
      "timeout": 600,
      "_type": "LLMNode"
    },
    "sandbox_eval": {
      "id": "sandbox_eval",
      "reads": [
        "candidate.py",
        "task.yaml"
      ],
      "writes": [
        "eval_result.json"
      ],
      "blocking": true,
      "command": "python -m srf.ops.run srf.ops.common.sandbox:run_eval",
      "callable_name": "srf.ops.common.sandbox:run_eval",
      "notes": "Run the task's eval command on the candidate and record the score.",
      "_type": "FnNode"
    },
    "archive_update": {
      "id": "archive_update",
      "reads": [
        "candidate.py",
        "eval_result.json",
        "population.json",
        "selected_parent.json"
      ],
      "writes": [
        "best_solution.py",
        "population.json",
        "shinka_state.json"
      ],
      "blocking": true,
      "command": "python -m srf.ops.run srf.ops.shinka.ops:update_shinka_archive",
      "callable_name": "srf.ops.shinka.ops:update_shinka_archive",
      "notes": "",
      "_type": "FnNode"
    }
  },
  "edges": [
    {
      "source": "build_prompt",
      "target": "generate",
      "condition": null
    },
    {
      "source": "sample_reflect",
      "target": "build_prompt",
      "condition": null
    },
    {
      "source": "generate",
      "target": "sandbox_eval",
      "condition": null
    },
    {
      "source": "sandbox_eval",
      "target": "archive_update",
      "condition": null
    },
    {
      "source": "archive_update",
      "target": "budget_check",
      "condition": null
    },
    {
      "source": "budget_check",
      "target": "sample_reflect",
      "condition": "reloop"
    },
    {
      "source": "budget_check",
      "target": "exit_shinka",
      "condition": "proceed"
    },
    {
      "source": "task_input",
      "target": "seed_run",
      "condition": null
    },
    {
      "source": "seed_run",
      "target": "sample_reflect",
      "condition": null
    }
  ],
  "start_node": "task_input",
  "terminal": true,
  "knob_values": {
    "temperature": 0.7,
    "reflect_interval": 5.0,
    "parent_selection": "best"
  },
  "knob_bounds": {
    "temperature": [
      0.3,
      0.5,
      0.7,
      0.9
    ],
    "reflect_interval": [
      3.0,
      5.0,
      10.0
    ],
    "parent_selection": [
      "best",
      "epsilon_greedy",
      "ucb",
      "uniform"
    ]
  }
}
